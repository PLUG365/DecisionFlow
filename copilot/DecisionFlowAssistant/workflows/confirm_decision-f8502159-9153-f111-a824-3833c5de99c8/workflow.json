            },
            "authentication": "@parameters(\u0027$authentication\u0027)"
          }
        },
        "Validate_current_issued_card": {
          "type": "If",
          "runAfter": {
            "List_current_issued_decisioncard": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(outputs(\u0027List_current_issued_decisioncard\u0027)?[\u0027body/value\u0027])",
                  0
                ]
              },
              {
                "equals": [
                  "@first(outputs(\u0027List_current_issued_decisioncard\u0027)?[\u0027body/value\u0027])?[\u0027ds_cardinstanceid\u0027]",
                  "@triggerBody()?[\u0027cardInstanceId\u0027]"
                ]
              }
            ]
          },
          "actions": {},
          "else": {
            "actions": {
              "Return_already_processed_card": {
                "type": "Response",
                "kind": "Skills",
                "runAfter": {},
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "status": "already_processed",
                    "applicationId": "@triggerBody()?[\u0027applicationId\u0027]",
                    "decisionRecordId": "",
                    "decidedAt": "",
                    "message": "\u5224\u65AD\u30AB\u30FC\u30C9\u304C\u7121\u52B9\u3001\u307E\u305F\u306F\u65E2\u306B\u4F7F\u7528\u6E08\u307F\u3067\u3059\u3002"
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "title": "status",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "applicationId": {
                        "title": "applicationId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "decisionRecordId": {
                        "title": "decisionRecordId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "decidedAt": {
                        "title": "decidedAt",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "message": {
                        "title": "message",
