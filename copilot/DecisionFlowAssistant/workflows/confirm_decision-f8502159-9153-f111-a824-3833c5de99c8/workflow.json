                },
                "authentication": "@parameters(\u0027$authentication\u0027)"
              }
            },
            "Consume_decisioncard": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Create_decision": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord"
                },
                "parameters": {
                  "entityName": "ds_decisioncards",
                  "recordId": "@first(outputs(\u0027List_current_issued_decisioncard\u0027)?[\u0027body/value\u0027])?[\u0027ds_decisioncardid\u0027]",
                  "item": {
                    "ds_status": 100000001,
                    "ds_consumedat": "@utcNow()"
                  }
                },
                "authentication": "@parameters(\u0027$authentication\u0027)"
              }
            },
