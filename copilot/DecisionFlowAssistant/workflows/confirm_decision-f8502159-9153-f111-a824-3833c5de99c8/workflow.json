          "actions": {},
          "else": {
            "actions": {
              "Return_invalid_empty_rationale": {
                "type": "Response",
                "kind": "Skills",
                "runAfter": {},
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "status": "invalid_target",
                    "applicationId": "@triggerBody()?[\u0027applicationId\u0027]",
                    "decisionRecordId": "",
                    "decidedAt": "",
