                        "title": "status",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "applicationId": {
                        "title": "applicationId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "decisionRecordId": {
                        "title": "decisionRecordId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "decidedAt": {
                        "title": "decidedAt",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "message": {
                        "title": "message",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      }
                    }
                  }
                }
              },
              "Stop_after_Return_invalid_empty_rationale": {
                "type": "Terminate",
                "runAfter": {
                  "Return_invalid_empty_rationale": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "runStatus": "Succeeded"
                }
              }
            }
          }
        },
        "List_current_issued_decisioncard": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Validate_rationale_exists": [
              "Succeeded"
