                    "decisionRecordId": "",
                    "decidedAt": "",
                    "message": "\u3053\u306E\u6848\u4EF6\u306E\u5224\u65AD\u8005\u3068\u3057\u3066\u5272\u308A\u5F53\u3066\u3089\u308C\u3066\u3044\u306A\u3044\u305F\u3081\u3001\u5224\u65AD\u3092\u78BA\u5B9A\u3067\u304D\u307E\u305B\u3093\u3002"
                  },
