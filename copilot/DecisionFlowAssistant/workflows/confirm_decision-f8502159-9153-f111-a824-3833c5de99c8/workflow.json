                      "applicationId": {
                        "title": "applicationId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "decisionRecordId": {
                        "title": "decisionRecordId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "decidedAt": {
                        "title": "decidedAt",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "message": {
                        "title": "message",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      }
                    }
                  }
                }
              },
              "Stop_after_Return_forbidden_not_decider": {
                "type": "Terminate",
