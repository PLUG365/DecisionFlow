            }
          }
        },
        "List_existing_decisions": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Validate_current_issued_card": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            },
            "parameters": {
              "entityName": "ds_decisions",
              "$filter": "@if(empty(outputs(\u0027Get_application\u0027)?[\u0027body/ds_submittedat\u0027]), concat(\u0027_ds_applicationid_value eq \u0027, triggerBody()?[\u0027applicationId\u0027]), concat(\u0027_ds_applicationid_value eq \u0027, triggerBody()?[\u0027applicationId\u0027], \u0027 and ds_decidedat ge \u0027, outputs(\u0027Get_application\u0027)?[\u0027body/ds_submittedat\u0027]))",
              "$select": "ds_decisionid,ds_decidedat"
            },
            "authentication": "@parameters(\u0027$authentication\u0027)"
          }
        },
        "First_write_wins_check": {
          "type": "If",
          "runAfter": {
            "List_existing_decisions": [
              "Succeeded"
            ]
          },
          "expression": {
            "equals": [
              "@length(outputs(\u0027List_existing_decisions\u0027)?[\u0027body/value\u0027])",
              0
            ]
          },
          "actions": {
            "Create_decision": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord"
                },
                "parameters": {
                  "entityName": "ds_decisions",
                  "item": {
                    "ds_name": "@concat(\u0027\u5224\u65AD - \u0027, triggerBody()?[\u0027applicationId\u0027])",
                    "ds_rationale": "@triggerBody()?[\u0027rationale\u0027]",
                    "ds_decidedat": "@utcNow()",
                    "ds_aisuggestionatdecision": "@outputs(\u0027Get_application\u0027)?[\u0027body/ds_aidecisionoptiontext\u0027]",
                    "ds_applicationid@odata.bind": "@concat(\u0027/ds_applications(\u0027, triggerBody()?[\u0027applicationId\u0027], \u0027)\u0027)",
                    "ds_deciderid@odata.bind": "@concat(\u0027/systemusers(\u0027, first(outputs(\u0027List_current_user\u0027)?[\u0027body/value\u0027])?[\u0027systemuserid\u0027], \u0027)\u0027)",
                    "ds_decisionoptionid@odata.bind": "@concat(\u0027/ds_decisionoptions(\u0027, first(outputs(\u0027Get_decision_option\u0027)?[\u0027body/value\u0027])?[\u0027ds_decisionoptionid\u0027], \u0027)\u0027)"
