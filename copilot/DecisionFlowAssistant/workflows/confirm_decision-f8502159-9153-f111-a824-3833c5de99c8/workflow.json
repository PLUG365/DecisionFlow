                "runAfter": {},
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "status": "invalid_target",
                    "applicationId": "@triggerBody()?[\u0027applicationId\u0027]",
                    "decisionRecordId": "",
                    "decidedAt": "",
                    "message": "\u5BFE\u8C61\u6848\u4EF6\u304C\u7121\u52B9\u307E\u305F\u306F\u53C2\u7167\u3067\u304D\u307E\u305B\u3093\u3002"
                  },
                  "schema": {
                    "type": "object",
