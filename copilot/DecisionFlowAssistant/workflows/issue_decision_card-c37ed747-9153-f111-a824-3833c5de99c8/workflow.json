{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "ds_shared_commondataserviceforapps"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "applicationId": {
                  "title": "applicationId",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true,
                  "description": "\u5224\u65AD\u5BFE\u8C61\u306E ds_application ID"
                },
                "actorAadObjectId": {
                  "title": "actorAadObjectId",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true,
                  "description": "\u5B9F\u884C\u8005\u306E Entra object ID\u3002\u53D6\u5F97\u3067\u304D\u306A\u3044\u5834\u5408\u306F\u7A7A\u3067\u3088\u3044"
                },
                "actorUpn": {
                  "title": "actorUpn",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true,
                  "description": "\u5B9F\u884C\u8005\u306E UPN \u307E\u305F\u306F\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9"
                }
              },
              "required": [
                "applicationId",
                "actorUpn"
              ]
            }
          }
        }
      },
      "actions": {
        "Compose_cardInstanceId": {
          "type": "Compose",
          "runAfter": {},
          "inputs": "@guid()"
        },
        "List_current_user": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Compose_cardInstanceId": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            },
            "parameters": {
              "entityName": "systemusers",
              "$filter": "@if(empty(triggerBody()?[\u0027actorAadObjectId\u0027]), concat(\u0027domainname eq \u0027\u0027\u0027, triggerBody()?[\u0027actorUpn\u0027], \u0027\u0027\u0027\u0027), concat(\u0027azureactivedirectoryobjectid eq \u0027, triggerBody()?[\u0027actorAadObjectId\u0027]))",
              "$select": "systemuserid,domainname,internalemailaddress,azureactivedirectoryobjectid"
            },
            "authentication": "@parameters(\u0027$authentication\u0027)"
          }
        },
        "Validate_user_found": {
          "type": "If",
          "runAfter": {
            "List_current_user": [
              "Succeeded"
            ]
          },
          "expression": {
            "greater": [
              "@length(outputs(\u0027List_current_user\u0027)?[\u0027body/value\u0027])",
              0
            ]
          },
          "actions": {},
          "else": {
            "actions": {
              "Return_forbidden_user_not_found": {
                "type": "Response",
                "kind": "Skills",
                "runAfter": {},
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "applicationId": "@triggerBody()?[\u0027applicationId\u0027]",
                    "cardInstanceId": "",
                    "status": "forbidden"
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "applicationId": {
                        "title": "applicationId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "cardInstanceId": {
                        "title": "cardInstanceId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "status": {
                        "title": "status",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      }
                    }
                  }
                }
              },
              "Stop_after_Return_forbidden_user_not_found": {
                "type": "Terminate",
                "runAfter": {
                  "Return_forbidden_user_not_found": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "runStatus": "Succeeded"
                }
              }
            }
          }
        },
        "Get_application": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Validate_user_found": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem"
            },
            "parameters": {
              "entityName": "ds_applications",
              "recordId": "@triggerBody()?[\u0027applicationId\u0027]",
              "$select": "ds_stage,_ds_deciderid_value"
            },
            "authentication": "@parameters(\u0027$authentication\u0027)"
          }
        },
        "Validate_application_found": {
          "type": "If",
          "runAfter": {
            "Get_application": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "expression": {
            "equals": [
              "@actions(\u0027Get_application\u0027)?[\u0027status\u0027]",
              "Succeeded"
            ]
          },
          "actions": {},
          "else": {
            "actions": {
              "Return_application_not_found": {
                "type": "Response",
                "kind": "Skills",
                "runAfter": {},
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "applicationId": "@triggerBody()?[\u0027applicationId\u0027]",
                    "cardInstanceId": "",
                    "status": "invalid_target"
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "applicationId": {
                        "title": "applicationId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "cardInstanceId": {
                        "title": "cardInstanceId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "status": {
                        "title": "status",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      }
                    }
                  }
                }
              },
              "Stop_after_Return_application_not_found": {
                "type": "Terminate",
                "runAfter": {
                  "Return_application_not_found": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "runStatus": "Succeeded"
                }
              }
            }
          }
        },
        "Validate_submitted_application": {
          "type": "If",
          "runAfter": {
            "Validate_application_found": [
              "Succeeded"
            ]
          },
          "expression": {
            "equals": [
              "@outputs(\u0027Get_application\u0027)?[\u0027body/ds_stage\u0027]",
              100000001
            ]
          },
          "actions": {},
          "else": {
            "actions": {
              "Return_invalid_application": {
                "type": "Response",
                "kind": "Skills",
                "runAfter": {},
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "applicationId": "@triggerBody()?[\u0027applicationId\u0027]",
                    "cardInstanceId": "",
                    "status": "invalid_target"
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "applicationId": {
                        "title": "applicationId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "cardInstanceId": {
                        "title": "cardInstanceId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "status": {
                        "title": "status",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      }
                    }
                  }
                }
              },
              "Stop_after_Return_invalid_application": {
                "type": "Terminate",
                "runAfter": {
                  "Return_invalid_application": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "runStatus": "Succeeded"
                }
              }
            }
          }
        },
        "Validate_actor_is_decider": {
          "type": "If",
          "runAfter": {
            "Validate_submitted_application": [
              "Succeeded"
            ]
          },
          "expression": {
            "equals": [
              "@toLower(coalesce(outputs(\u0027Get_application\u0027)?[\u0027body/_ds_deciderid_value\u0027], \u0027\u0027))",
              "@toLower(first(outputs(\u0027List_current_user\u0027)?[\u0027body/value\u0027])?[\u0027systemuserid\u0027])"
            ]
          },
          "actions": {},
          "else": {
            "actions": {
              "Return_forbidden_not_decider": {
                "type": "Response",
                "kind": "Skills",
                "runAfter": {},
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "applicationId": "@triggerBody()?[\u0027applicationId\u0027]",
                    "cardInstanceId": "",
                    "status": "forbidden"
                  },
                  "schema": {
                    "type": "object",
                    "properties": {
                      "applicationId": {
                        "title": "applicationId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "cardInstanceId": {
                        "title": "cardInstanceId",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      },
                      "status": {
                        "title": "status",
                        "type": "string",
                        "x-ms-dynamically-added": true
                      }
                    }
                  }
                }
              },
              "Stop_after_Return_forbidden_not_decider": {
                "type": "Terminate",
                "runAfter": {
                  "Return_forbidden_not_decider": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "runStatus": "Succeeded"
                }
              }
            }
          }
        },
        "List_prior_issued_decisioncards": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Validate_actor_is_decider": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords"
            },
            "parameters": {
              "entityName": "ds_decisioncards",
              "$filter": "@if(empty(triggerBody()?[\u0027actorAadObjectId\u0027]), concat(\u0027_ds_applicationid_value eq \u0027, triggerBody()?[\u0027applicationId\u0027], \u0027 and ds_actorupn eq \u0027\u0027\u0027, triggerBody()?[\u0027actorUpn\u0027], \u0027\u0027\u0027 and ds_status eq 100000000\u0027), concat(\u0027_ds_applicationid_value eq \u0027, triggerBody()?[\u0027applicationId\u0027], \u0027 and ds_actoraadobjectid eq \u0027\u0027\u0027, triggerBody()?[\u0027actorAadObjectId\u0027], \u0027\u0027\u0027 and ds_status eq 100000000\u0027))",
              "$select": "ds_decisioncardid,ds_cardinstanceid,ds_status,ds_actoraadobjectid,ds_actorupn"
            },
            "authentication": "@parameters(\u0027$authentication\u0027)"
          }
        },
        "Supersede_prior_issued_decisioncards": {
          "type": "Foreach",
          "runAfter": {
            "List_prior_issued_decisioncards": [
              "Succeeded"
            ]
          },
          "foreach": "@outputs(\u0027List_prior_issued_decisioncards\u0027)?[\u0027body/value\u0027]",
          "actions": {
            "Supersede_prior_issued_decisioncard": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord"
                },
                "parameters": {
                  "entityName": "ds_decisioncards",
                  "recordId": "@items(\u0027Supersede_prior_issued_decisioncards\u0027)?[\u0027ds_decisioncardid\u0027]",
                  "item": {
                    "ds_status": 100000002,
                    "ds_supersededat": "@utcNow()"
                  }
                },
                "authentication": "@parameters(\u0027$authentication\u0027)"
              }
            }
          }
        },
        "Create_decisioncard": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Supersede_prior_issued_decisioncards": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord"
            },
            "parameters": {
              "entityName": "ds_decisioncards",
              "item": {
                "ds_name": "@concat(\u0027\u5224\u65AD\u30AB\u30FC\u30C9 - \u0027, triggerBody()?[\u0027applicationId\u0027])",
                "ds_cardinstanceid": "@outputs(\u0027Compose_cardInstanceId\u0027)",
                "ds_actoraadobjectid": "@triggerBody()?[\u0027actorAadObjectId\u0027]",
                "ds_actorupn": "@triggerBody()?[\u0027actorUpn\u0027]",
                "ds_status": 100000000,
                "ds_issuedat": "@utcNow()",
                "ds_applicationid@odata.bind": "@concat(\u0027/ds_applications(\u0027, triggerBody()?[\u0027applicationId\u0027], \u0027)\u0027)"
              }
            },
            "authentication": "@parameters(\u0027$authentication\u0027)"
          }
        },
        "Return_card_context": {
          "type": "Response",
          "kind": "Skills",
          "runAfter": {
            "Create_decisioncard": [
              "Succeeded"
            ]
          },
          "inputs": {
            "statusCode": 200,
            "body": {
              "applicationId": "@triggerBody()?[\u0027applicationId\u0027]",
              "cardInstanceId": "@outputs(\u0027Compose_cardInstanceId\u0027)",
              "status": "issued"
            },
            "schema": {
              "type": "object",
              "properties": {
                "applicationId": {
                  "title": "applicationId",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "cardInstanceId": {
                  "title": "cardInstanceId",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "status": {
                  "title": "status",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            }
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}