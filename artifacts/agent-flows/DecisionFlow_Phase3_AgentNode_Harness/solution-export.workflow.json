{
  "properties": {
    "connectionReferences": {
      "shared_agentnode": {
        "api": {
          "name": "shared_agentnode"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedagentnode_c6fa5"
        },
        "runtimeSource": "invoker"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "actions": {
        "Run_an_agent": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "body/agentId": "ds_DecisionFlowAssistant",
              "body/prompt": "あなたは企業内の意思決定支援アシスタントです。これはPhase 3の読み取り専用ベンチマークです。ツールを呼び出さず、データを書き込まないでください。入力だけを根拠に判断者向け推奨案を作成し、指定されたJSONスキーマへ厳密に出力してください。\n\n制約:\n- recommendedOption は判断選択肢の名称から1つ選ぶ。\n- applicationSummary は3〜5文。\n- 会話履歴がない場合は conversationSummary を「提出時点では会話履歴はありません。」とする。\n- 過去の判断理由は原文のまま使用し、推測した理由を書かない。\n- レギュレーションの充足状況、懸念、追加確認事項を comment または risks に含める。\n\n申請情報:\n@{triggerBody()?['text']}\n\n関連資料:\n@{triggerBody()?['text_1']}\n\n会話履歴:\n@{triggerBody()?['text_2']}\n\n過去類似案件:\n@{triggerBody()?['text_3']}\n\n判断選択肢:\n@{triggerBody()?['text_4']}\n\nカテゴリ別レギュレーション:\n@{triggerBody()?['text_5']}",
              "body/isHitlEscalationEnabled": false,
              "body/outputSchema": {
                "type": "object",
                "properties": {
                  "applicationSummary": {
                    "type": "string",
                    "description": "申請の論点を判断者向けに3〜5文で要約する。"
                  },
                  "conversationSummary": {
                    "type": "string",
                    "description": "会話履歴の論点、追加確認、合意事項を要約する。履歴がなければその旨を明記する。"
                  },
                  "recommendedOption": {
                    "type": "string",
                    "description": "入力された判断選択肢の名称から最も近いものを1つ返す。"
                  },
                  "comment": {
                    "type": "string",
                    "description": "推奨理由、レギュレーション充足状況、追加確認事項を簡潔に示す。"
                  },
                  "risks": {
                    "type": "array",
                    "description": "判断前に確認すべきリスクの一覧。",
                    "items": {
                      "type": "object",
                      "properties": {
                        "category": {
                          "type": "string",
                          "description": "リスク分類。"
                        },
                        "detail": {
                          "type": "string",
                          "description": "具体的な懸念または追加確認事項。"
                        }
                      },
                      "required": [
                        "category",
                        "detail"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "similarCases": {
                    "type": "array",
                    "description": "判断根拠として参照した過去案件。",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "description": "過去案件のタイトル。"
                        },
                        "decision": {
                          "type": "string",
                          "description": "過去案件で実際に選ばれた判断。"
                        },
                        "reason": {
                          "type": "string",
                          "description": "記録された判断理由の原文。空なら「理由の記録なし」。"
                        }
                      },
                      "required": [
                        "title",
                        "decision",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "applicationSummary",
                  "conversationSummary",
                  "recommendedOption",
                  "comment",
                  "risks",
                  "similarCases"
                ],
                "additionalProperties": false
              }
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_agentnode",
              "operationId": "InvokeAgent",
              "connectionName": "shared_agentnode"
            }
          },
          "runAfter": {}
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "description": "入力を指定してください",
                  "title": "application",
